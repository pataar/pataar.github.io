---
import Link from "../components/Link.astro";
import PageHeader from "../components/PageHeader.astro";
import { renderedCollection } from "../config/content";
import Layout from "../layouts/Layout.astro";

const projects = await renderedCollection("projects");
---

<Layout title="Projects" description="Open source projects by Pieter Willekens: terminal tools, Prometheus exporters, Laravel packages, and 3D printing software.">
	<PageHeader title="Projects">
		Open source is close to my heart, as an idea and in practice: software gets better when it's built in the open. I
		contribute where I can and want to do more of it. Some things I've built or helped build:
	</PageHeader>

	<ul class="mt-10 space-y-4">
		{
			projects.map(({ Content, data, id }) => (
				<li class="panel leading-relaxed text-fg-muted">
					<span aria-hidden="true" class="select-none text-comment">- </span>
					<h2 class="inline text-base font-normal">
						<Link href={data.url}>{id}</Link>
					</h2>: <span class="[&_p]:inline"><Content /></span>
					{data.install && (
						<div class="mt-2 text-sm">
							<span aria-hidden="true" class="select-none text-comment">$ </span>
							<code class="text-green">{data.install}</code>
						</div>
					)}
				</li>
			))
		}
	</ul>
</Layout>
