---
import { getCollection } from "astro:content";
import CategoryCard from "../components/CategoryCard.astro";
import PageHeader from "../components/PageHeader.astro";
import Skill from "../components/Skill.astro";
import Layout from "../layouts/Layout.astro";

const categories = (await getCollection("likes")).toSorted((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Things I like to work with"
	description="The languages, frameworks, and tools I reach for first: TypeScript, React, Laravel, Kubernetes, and more.">
	<PageHeader title="Things I like to work with">
		The languages, frameworks, and tools I reach for first, ordered by preference rather than alphabetically. The daily
		setup lives in <a href="/uses/">uses.toml</a>.
	</PageHeader>

	<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			categories.map(category => (
				<CategoryCard name={category.data.name}>
					{category.data.skills.map(skill => (
						<Skill icon={skill.icon} url={skill.url}>
							{skill.label}
						</Skill>
					))}
				</CategoryCard>
			))
		}
	</div>
</Layout>
