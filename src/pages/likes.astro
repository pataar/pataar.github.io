---
import Skill from "../components/Skill.astro";
import Layout from "../layouts/Layout.astro";

interface SkillItem {
	icon: string;
	label: string;
}

interface Category {
	name: string;
	skills: SkillItem[];
}

// Skills are ordered by preference, not alphabetically.
const categories: Category[] = [
	{
		name: "languages & runtimes",
		skills: [
			{ icon: "simple-icons:typescript", label: "TypeScript" },
			{ icon: "simple-icons:javascript", label: "JavaScript (ES6+)" },
			{ icon: "simple-icons:nodedotjs", label: "Node.js" },
			{ icon: "simple-icons:php", label: "PHP" },
			{ icon: "simple-icons:sass", label: "Sass" },
			{ icon: "simple-icons:go", label: "Go" },
			{ icon: "simple-icons:rust", label: "Rust" },
			{ icon: "simple-icons:bun", label: "Bun" },
		],
	},
	{
		name: "frameworks & libraries",
		skills: [
			{ icon: "simple-icons:react", label: "React" },
			{ icon: "simple-icons:laravel", label: "Laravel" },
			{ icon: "simple-icons:tailwindcss", label: "Tailwind CSS" },
			{ icon: "simple-icons:expo", label: "Expo + React Native" },
			{ icon: "simple-icons:vuedotjs", label: "Vue" },
			{ icon: "simple-icons:astro", label: "Astro" },
		],
	},
	{
		name: "tools",
		skills: [
			{ icon: "simple-icons:gnubash", label: "zsh / bash" },
			{ icon: "simple-icons:git", label: "git" },
			{ icon: "simple-icons:webpack", label: "webpack" },
			{ icon: "simple-icons:vite", label: "Vite" },
			{ icon: "simple-icons:mysql", label: "MySQL" },
			{ icon: "simple-icons:redis", label: "Redis" },
			{ icon: "simple-icons:grafana", label: "Grafana" },
			{ icon: "simple-icons:prometheus", label: "Prometheus" },
			{ icon: "simple-icons:vitest", label: "Jest / Vitest" },
			{ icon: "simple-icons:helm", label: "Helm" },
			{ icon: "simple-icons:reactquery", label: "TanStack Query" },
			{ icon: "lucide:paw-print", label: "Zustand" },
		],
	},
	{
		name: "operating systems",
		skills: [
			{ icon: "simple-icons:cachyos", label: "CachyOS (daily driver)" },
			{ icon: "simple-icons:debian", label: "Debian" },
			{ icon: "simple-icons:ubuntu", label: "Ubuntu" },
			{ icon: "simple-icons:apple", label: "macOS" },
		],
	},
	{
		name: "devops",
		skills: [
			{ icon: "simple-icons:kubernetes", label: "Kubernetes" },
			{ icon: "simple-icons:rancher", label: "Rancher" },
			{ icon: "simple-icons:docker", label: "Docker" },
			{ icon: "simple-icons:github", label: "GitHub Actions" },
			{ icon: "simple-icons:gitlab", label: "GitLab CI" },
		],
	},
	{
		name: "networking",
		skills: [
			{ icon: "simple-icons:nginx", label: "nginx" },
			{ icon: "simple-icons:traefikproxy", label: "Traefik" },
			{ icon: "simple-icons:caddy", label: "Caddy" },
		],
	},
	{
		name: "homelab",
		skills: [
			{ icon: "simple-icons:unraid", label: "Unraid" },
			{ icon: "simple-icons:homeassistant", label: "Home Assistant" },
			{ icon: "simple-icons:ubiquiti", label: "UniFi" },
		],
	},
];
---

<Layout
	title="Things I like to work with"
	description="The languages, frameworks, and tools I reach for first: TypeScript, React, Laravel, Kubernetes, and more.">
	<header>
		<h1 class="text-3xl font-bold text-fg"><span class="select-none text-comment"># </span>Things I like to work with.</h1>
		<p class="mt-4 leading-relaxed text-fg-muted">
			The languages, frameworks, and tools I reach for first, ordered by preference rather than alphabetically.
		</p>
	</header>

	<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			categories.map(category => (
				<section class="rounded-lg border border-edge bg-bg-dark/70 p-5">
					<h2 class="mb-4 font-semibold text-blue">[{category.name}]</h2>
					{category.skills.map(skill => (
						<Skill icon={skill.icon}>{skill.label}</Skill>
					))}
				</section>
			))
		}
	</div>
</Layout>
