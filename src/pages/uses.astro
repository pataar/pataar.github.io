---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import CategoryCard from "../components/CategoryCard.astro";
import Link from "../components/Link.astro";
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";

const categories = (await getCollection("uses")).toSorted((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Things I use"
	description="The daily setup of Pieter Willekens: CachyOS, Ghostty, Zed, Claude Code, and the rest of the toolbox.">
	<PageHeader title="Things I use">
		The daily setup: always changing, never finished. Tech preferences live in <a href="/likes/">likes.toml</a>.
	</PageHeader>

	<div class="mt-10 grid gap-6 lg:grid-cols-2">
		{
			categories.map(category => (
				<CategoryCard name={category.data.name}>
					<div class="grid grid-cols-[auto_auto_auto_1fr] gap-x-3 gap-y-3">
						{category.data.items.map(item => (
							<>
								<Icon name={item.icon} class="mt-[3px] h-4.5 w-4.5 self-start text-fg-muted" />
								<Link href={item.url} class="text-fg no-underline hover:underline">
									{item.name}
								</Link>
								<span aria-hidden="true" class="select-none text-cyan">=</span>
								<span class="text-green">"{item.description}"</span>
							</>
						))}
					</div>
				</CategoryCard>
			))
		}
	</div>
</Layout>
