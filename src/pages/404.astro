---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="Page not found.">
	<h1 class="text-3xl font-bold"><span class="text-red">E404</span><span class="text-fg">: Can't open file</span></h1>
	<p class="mt-4 leading-relaxed text-fg-muted">
		This buffer doesn't exist. The file may have been moved, deleted, or never written in the first place.
	</p>
	<p class="mt-6"><a href="/">:e index.md</a></p>
</Layout>
