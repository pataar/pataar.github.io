---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import portrait from "../assets/icon.png";
import ContactIcons from "../components/ContactIcons.astro";
import MeCode from "../components/MeCode.astro";
import Section from "../components/Section.astro";
import TypedName from "../components/TypedName.astro";
import Layout from "../layouts/Layout.astro";

const sections = await Promise.all(
	(await getCollection("home"))
		.toSorted((a, b) => a.data.order - b.data.order)
		.map(async entry => ({ Content: (await render(entry)).Content, data: entry.data })),
);
---

<Layout description="Pieter Willekens, tech lead at Interactive Studios. Laravel, React, TypeScript, Kubernetes. Dad, developer and drummer, based in the Netherlands.">
	<div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between">
		<header class="flex items-center gap-6">
			<Image
				alt="Pieter's profile"
				src={portrait}
				width="224"
				loading="eager"
				class="h-24 w-24 shrink-0 rounded-full border-2 border-edge object-cover object-[50%_18%] sm:h-28 sm:w-28"
			/>
			<div>
				<h1 class="text-3xl font-bold text-fg">
					<TypedName text="Pieter Willekens" />
				</h1>
				<p class="mt-2 text-fg-muted"><span class="text-comment select-none">// </span>Dad, developer and drummer.</p>
				<div class="mt-4">
					<ContactIcons />
				</div>
			</div>
		</header>
		<div class="lg:w-105 lg:shrink-0">
			<MeCode />
		</div>
	</div>

	{
		sections.map(({ Content, data }) => (
			<Section title={data.title} command={data.command}>
				<Content />
			</Section>
		))
	}
</Layout>
