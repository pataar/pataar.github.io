---
import type { TypedText } from "../lib/typewriter";

interface Props {
	text: string;
	typed: TypedText;
}

const { text, typed } = Astro.props;
const { words, endSeconds } = typed;
---

<span class="sr-only">{text}</span>
<span aria-hidden="true">
	{
		words.map((word, index) => (
			<>
				<span class="inline-block">
					{word.letters.map(({ fromSeconds, letter, revealSeconds }) => (
						<span class="letter" style={`--from: ${fromSeconds.toFixed(2)}s; --at: ${revealSeconds.toFixed(2)}s`}>
							{letter}
						</span>
					))}
				</span>
				{index < words.length - 1 && " "}
			</>
		))
	}<span class="typed-cursor ml-1 select-none text-blue" style={`--at: ${endSeconds.toFixed(2)}s`}>▊</span>
</span>
