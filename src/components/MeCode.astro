---
interface Token {
	class?: string;
	text: string;
}

// Key order here is render order in the code block.
const me = {
	name: "Pieter Willekens",
	role: "Tech Lead",
	org: "Interactive Studios",
	stack: ["Laravel", "React", "TS", "K8s"],
	base: "The Netherlands",
	uptime: "since 1992",
};

const kw = "text-magenta";
const prop = "text-blue";
const str = "text-green";
const op = "text-cyan";

const keyPadding = Math.max(...Object.keys(me).map(key => key.length));
const stringValue = (value: string): Token => ({ class: str, text: `"${value}"` });
const arrayValue = (values: string[]): Token[] => [
	{ text: "[" },
	...values.flatMap((value, index) => [...(index > 0 ? [{ text: ", " }] : []), stringValue(value)]),
	{ text: "]" },
];

const lines: Token[][] = [
	[{ class: kw, text: "const" }, { text: " me " }, { class: op, text: "=" }, { text: " {" }],
	...Object.entries(me).map(([key, value]) => [
		{ text: "  " },
		{ class: prop, text: key },
		{ text: `:${" ".repeat(keyPadding - key.length)} ` },
		...(Array.isArray(value) ? arrayValue(value) : [stringValue(value)]),
		{ text: "," },
	]),
	[{ text: "} " }, { class: kw, text: "as const" }, { text: ";" }],
];

/* Typing delays are randomized at build time; the animation is pure CSS, no client JS.

   Uniform delays read as a slide-in, so mimic a human rhythm instead: bursts of quick keystrokes
   (squaring the random skews toward fast keys with a long tail), occasional hesitations, and a
   breath after each Enter. Leading indentation appears instantly, like an editor's auto-indent. */
const keystrokeSeconds = (): number => {
	const burst = 0.008 + Math.random() ** 2 * 0.06;
	const hesitation = Math.random() < 0.04 ? 0.08 + Math.random() * 0.18 : 0;
	return burst + hesitation;
};

let elapsedSeconds = 1.0;
let cursorLandsSeconds = elapsedSeconds;
const typedLines = lines.map((tokens, lineIndex) => {
	if (lineIndex > 0) elapsedSeconds += 0.12 + Math.random() * 0.25;
	let atLineStart = true;
	return tokens.map(token => ({
		class: token.class,
		chars: token.text.split("").map(char => {
			if (atLineStart && char === " ") return { char, fromSeconds: cursorLandsSeconds, revealSeconds: cursorLandsSeconds };
			atLineStart = false;
			const fromSeconds = cursorLandsSeconds;
			elapsedSeconds += keystrokeSeconds();
			cursorLandsSeconds = elapsedSeconds;
			return { char, fromSeconds, revealSeconds: elapsedSeconds };
		}),
	}));
});
---

<figure class="me-code overflow-hidden rounded-lg border border-edge bg-bg-dark/70 text-sm" aria-label="me.ts">
	<figcaption class="border-b border-edge px-4 py-1.5 text-xs text-comment">
		me.ts <span class="text-green">[+]</span>
	</figcaption>
	<div class="overflow-x-auto p-4 leading-relaxed">
		<pre
			aria-hidden="true"><code>{typedLines.map(line => [
	<span class="line">{line.map(token => <span class={token.class}>{token.chars.map(({ char, fromSeconds, revealSeconds }) => <span class="letter" style={`--from: ${fromSeconds.toFixed(2)}s; --at: ${revealSeconds.toFixed(2)}s`}>{char}</span>)}</span>)}</span>,
	"\n",
])}</code></pre>
	</div>
</figure>

<style is:global>
	.me-code code {
		counter-reset: line;
	}

	.me-code .line {
		counter-increment: line;
	}

	.me-code .line::before {
		color: var(--tn-comment);
		content: counter(line);
		display: inline-block;
		margin-right: 1.25rem;
		text-align: right;
		user-select: none;
		width: 1ch;
	}

	/* The riding block cursor comes from the shared .letter cursor-cell animation (global.css);
	   the name in the hero keeps the site's single blinking cursor */
</style>
