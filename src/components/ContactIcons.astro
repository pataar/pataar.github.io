---
import { Icon } from "astro-icon/components";
import { contacts } from "../config/contacts";
---

<ul class="flex flex-wrap gap-1">
	{
		contacts.map(({ icon, label, url }) => (
			<li>
				<a
					aria-label={label}
					title={label}
					href={url}
					target="_blank"
					rel="noreferrer"
					class="inline-flex h-8 w-8 items-center justify-center text-fg-muted no-underline transition-transform hover:scale-110 hover:text-blue">
					<Icon name={icon} class="h-[18px] w-[18px]" />
				</a>
			</li>
		))
	}
</ul>
