---
import { getImage } from "astro:assets";
import fontLatinUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import portrait from "../assets/icon.png";
import StatusLine from "../components/StatusLine.astro";
import TopBar from "../components/TopBar.astro";
import { contacts } from "../config/contacts";
import "../styles/global.css";

interface Props {
	description: string;
	/** Page title; omit only on the homepage, which uses the brand title. */
	title?: string;
}

const { description, title } = Astro.props;

const fontFace = `@font-face{font-family:"JetBrains Mono Variable";font-style:normal;font-weight:100 800;font-display:swap;src:url(${fontLatinUrl}) format("woff2-variations");}`;

const fullTitle = title ? `${title} | Pieter Willekens` : "Pieter Willekens - Tech Lead & Full Stack Developer";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL((await getImage({ format: "jpeg", height: 512, src: portrait, width: 512 })).src, Astro.site);

const personSchema = {
	"@context": "https://schema.org",
	"@id": new URL("/#person", Astro.site).href,
	"@type": "Person",
	description:
		"Tech lead on the Patient Journey App at Interactive Studios. Full-stack development with Laravel, React, TypeScript, and Kubernetes.",
	image: ogImage.href,
	jobTitle: "Tech Lead & Full Stack Developer",
	knowsAbout: ["Laravel", "React", "TypeScript", "PHP", "Kubernetes", "Docker", "React Native", "Rust", "Go", "DevOps"],
	name: "Pieter Willekens",
	sameAs: contacts.map(contact => contact.url).filter(url => url.startsWith("https://")),
	url: Astro.site?.href,
	worksFor: { "@type": "Organization", name: "Interactive Studios", url: "https://www.interactivestudios.nl" },
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Pieter Willekens",
	publisher: { "@id": personSchema["@id"] },
	url: Astro.site?.href,
};
---

<!doctype html>
<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Pieter Willekens" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16161e" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#d0d5e3" />

		<title>{fullTitle}</title>
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="preload" as="font" type="font/woff2" crossorigin href={fontLatinUrl} />
		<style is:inline set:html={fontFace}></style>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:alt" content="Portrait of Pieter Willekens" />
		<meta property="og:site_name" content="Pieter Willekens" />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body class="flex min-h-dvh flex-col bg-bg text-fg">
		<TopBar />
		<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 md:px-8 md:py-12">
			<slot />
			<div aria-hidden="true" class="mt-12 select-none leading-8 text-comment/70">~<br />~<br />~</div>
		</main>
		<StatusLine />
	</body>
</html>
